@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "All Questions";
}
@model List<Examprep.Application.DTOs.QuestionResponseDto>
@{
    ViewData["Title"] = "Questions";
    string? role = ViewBag.Role;
    var questions = Model ?? new List<Examprep.Application.DTOs.QuestionResponseDto>();
    var categories = ViewBag.Categories as List<string?> ?? new List<string?>();
    var selectedCategory = ViewBag.Category as string;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-list-ul me-1"></i> All Questions</h5>
        <span class="badge bg-primary">@questions.Count total</span>
    </div>

    <div class="card-body">

        @if (role == "Admin")
        {
            <!-- CSV Upload -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6><i class="bi bi-filetype-csv text-primary me-1"></i> Bulk Upload (CSV)</h6>
                    <form method="post" action="/Questions/UploadCsv" enctype="multipart/form-data" class="d-flex gap-2">
                        <input type="file" name="file" accept=".csv" class="form-control" required />
                        <button class="btn btn-primary"><i class="bi bi-upload"></i> Upload</button>
                    </form>
                    <small class="text-muted">
                        Format: <code>Text,OptionA,OptionB,OptionC,OptionD,CorrectOption,Category</code>
                    </small>
                </div>
            </div>

            <!-- Single Add -->
            <form method="post" action="/Questions/Create" class="d-flex gap-2 mb-3">
                <input name="Text" class="form-control" placeholder="Type a new question..." required />
                <input name="Category" class="form-control" placeholder="Category" style="max-width:200px;" />
                <button class="btn btn-success"><i class="bi bi-plus-lg"></i> Add</button>
            </form>
        }

        <!-- Category filter -->
        <form method="get" action="/Questions" class="mb-3 d-flex gap-2">
            <select name="category" class="form-select" style="max-width:250px;" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    if (string.IsNullOrEmpty(c)) continue;
                    <option value="@c" selected="@(c == selectedCategory)">@c</option>
                }
            </select>
        </form>

        @if (questions.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size:3rem;"></i>
                <p class="mt-2 mb-0">No questions yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>Question</th>
                            <th style="width:120px;">Category</th>
                            <th style="width:250px;">Owner</th>
                            @if (role == "Admin")
                            {
                                <th style="width:80px;"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in questions)
                        {
                            <tr>
                                <td class="text-muted">@q.Id</td>
                                <td>
                                    <strong>@q.Text</strong>
                                    @if (!string.IsNullOrEmpty(q.OptionA))
                                    {
                                        <div class="mt-1 small text-muted">
                                            A) @q.OptionA &nbsp;
                                            B) @q.OptionB &nbsp;
                                            C) @q.OptionC &nbsp;
                                            D) @q.OptionD
                                            @if (role == "Admin")
                                            {
                                                <span class="badge bg-success ms-2">Correct: @q.CorrectOption</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(q.Category))
                                    {
                                        <span class="badge bg-secondary">@q.Category</span>
                                    }
                                </td>
                                <td>
                                    <i class="bi bi-person-circle text-secondary me-1"></i>
                                    @q.UserEmail
                                </td>
                                @if (role == "Admin")
                                {
                                    <td>
                                        <form method="post" action="/Questions/Delete/@q.Id">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>