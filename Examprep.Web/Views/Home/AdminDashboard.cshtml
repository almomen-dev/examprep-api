@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-4 p-4 rounded-3 text-white" style="background: linear-gradient(135deg,#6610f2,#dc3545);">
    <h2 class="mb-1"><i class="bi bi-shield-lock-fill"></i> Admin Panel</h2>
    <p class="mb-0 opacity-75">Manage questions, users, and monitor platform activity.</p>
</div>

<!-- Admin stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total Questions</div>
                <div class="h3 mb-0 text-primary" id="totalQuestions">—</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Your Role</div>
                <div class="h3 mb-0 text-danger">Admin</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">API Status</div>
                <div class="h3 mb-0 text-success">Online</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Version</div>
                <div class="h3 mb-0 text-warning">v1</div>
            </div>
        </div>
    </div>
</div>

<!-- Admin actions -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-controller="Questions" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center">
                <div class="card-body py-4">
                    <i class="bi bi-list-ul text-primary" style="font-size:2.5rem;"></i>
                    <h5 class="mt-2 mb-1 text-dark">Manage Questions</h5>
                    <p class="text-muted small mb-0">Add, upload, delete</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Users" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center">
                <div class="card-body py-4">
                    <i class="bi bi-people text-success" style="font-size:2.5rem;"></i>
                    <h5 class="mt-2 mb-1 text-dark">Manage Users</h5>
                    <p class="text-muted small mb-0">Promote, demote, delete</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Exam" asp-action="AllResults" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center">
                <div class="card-body py-4">
                    <i class="bi bi-bar-chart text-info" style="font-size:2.5rem;"></i>
                    <h5 class="mt-2 mb-1 text-dark">All Results</h5>
                    <p class="text-muted small mb-0">User performance</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="/swagger" target="_blank" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center">
                <div class="card-body py-4">
                    <i class="bi bi-code-square text-dark" style="font-size:2.5rem;"></i>
                    <h5 class="mt-2 mb-1 text-dark">API Docs</h5>
                    <p class="text-muted small mb-0">Open Swagger</p>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Recent questions -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-clock-history text-secondary me-1"></i> Recent Questions</h5>
    </div>
    <div class="card-body p-0">
        <div id="recentQuestions" class="list-group list-group-flush">
            <div class="p-3 text-muted text-center">Loading...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        fetch('/api/v1/questions')
            .then(r => r.json())
            .then(data => {
                document.getElementById('totalQuestions').innerText = data.length;

                const list = document.getElementById('recentQuestions');
                list.innerHTML = '';

                if (!data.length) {
                    list.innerHTML = '<div class="p-3 text-muted text-center">No questions yet.</div>';
                    return;
                }

                data.slice(-5).reverse().forEach(q => {
                    list.innerHTML += `
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>#${q.id}</strong> — ${q.text}
                                <div class="small text-muted">by ${q.userEmail ?? 'unknown'}</div>
                            </div>
                            <a href="/Questions" class="btn btn-sm btn-outline-primary">View</a>
                        </div>`;
                });
            })
            .catch(() => {
                document.getElementById('totalQuestions').innerText = '?';
                document.getElementById('recentQuestions').innerHTML =
                    '<div class="p-3 text-danger text-center">Could not load questions.</div>';
            });
    </script>
}