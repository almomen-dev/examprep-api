@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard";
    var stats = ViewBag.Stats as Examprep.Application.DTOs.UserStatsDto;
    var recent = ViewBag.Recent as List<Examprep.Application.DTOs.RecentAttemptDto> ?? new List<Examprep.Application.DTOs.RecentAttemptDto>();

    var examsTaken = stats?.ExamsTaken ?? 0;
    var questionsSolved = stats?.QuestionsSolved ?? 0;
    var avgScore = stats?.AverageScore ?? 0;
    var bestScore = stats?.BestScore ?? 0;
}

<style>
    .welcome-banner {
        background: linear-gradient(135deg, #4f46e5, #0ea5e9);
        border-radius: 20px;
        color: white;
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
    }

    .welcome-banner::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 300px;
        height: 300px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
    }

    .stat-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #fff;
        transition: transform 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.04);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
</style>

<!-- Welcome Banner -->
<div class="welcome-banner mb-4 shadow-sm">
    <div class="row align-items-center position-relative" style="z-index: 1;">
        <div class="col-md-8">
            <h2 class="fw-bold mb-2">Welcome back! 👋</h2>
            <p class="mb-0 opacity-75 fs-5">Ready to crush your next practice session? Let's get started.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-controller="Exam" asp-action="Start" class="btn btn-light text-primary fw-bold px-4 py-2">
                <i class="bi bi-play-fill"></i> Start New Exam
            </a>
        </div>
    </div>
</div>

<!-- Real Stats -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div>
                    <p class="text-muted mb-1 small fw-medium">Exams Taken</p>
                    <h4 class="fw-bold mb-0">@examsTaken</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-success bg-opacity-10 text-success me-3">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <p class="text-muted mb-1 small fw-medium">Questions Solved</p>
                    <h4 class="fw-bold mb-0">@questionsSolved</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning me-3">
                    <i class="bi bi-bullseye"></i>
                </div>
                <div>
                    <p class="text-muted mb-1 small fw-medium">Average Score</p>
                    <h4 class="fw-bold mb-0">@avgScore%</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-info bg-opacity-10 text-info me-3">
                    <i class="bi bi-trophy"></i>
                </div>
                <div>
                    <p class="text-muted mb-1 small fw-medium">Best Score</p>
                    <h4 class="fw-bold mb-0">@bestScore%</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Practice Tests</h5>
                <a asp-controller="Exam" asp-action="History" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body">
                @if (recent.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                        <p class="mt-2 mb-0 text-muted">No exams taken yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 rounded-start">Attempt</th>
                                    <th class="border-0">Date</th>
                                    <th class="border-0">Score</th>
                                    <th class="border-0 rounded-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in recent)
                                {
                                    <tr>
                                        <td class="fw-medium">Attempt #@a.AttemptId</td>
                                        <td class="text-muted">
                                            @(a.CompletedAt.HasValue
                                                ? a.CompletedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                                : "—")
                                        </td>
                                        <td class="fw-bold">
                                            @if (a.IsCompleted)
                                            {
                                                <span>@a.CorrectCount / @a.TotalQuestions</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (a.IsCompleted)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1">In Progress</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="fw-bold mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <a asp-controller="Exam" asp-action="Start" class="btn btn-primary w-100 py-2 fw-medium rounded-3 mb-2">
                    <i class="bi bi-play-circle me-2"></i> Take New Exam
                </a>
                <a asp-controller="Exam" asp-action="History" class="btn btn-outline-primary w-100 py-2 fw-medium rounded-3 mb-2">
                    <i class="bi bi-clock-history me-2"></i> View History
                </a>
                <a asp-controller="Home" asp-action="Leaderboard" class="btn btn-outline-success w-100 py-2 fw-medium rounded-3">
                    <i class="bi bi-trophy me-2"></i> Leaderboard
                </a>
            </div>
        </div>
    </div>
</div>