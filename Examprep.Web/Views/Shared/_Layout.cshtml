<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Examprep</title>
    <link rel="icon" type="image/png" href="~/images/exam.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-color: #4f46e5;
            --body-bg: #f8fafc;
        }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            background-color: var(--body-bg);
            color: #334155;
            overflow-x: hidden;
        }

        .public-nav {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #e2e8f0;
            padding: 1rem 0;
        }

            .public-nav .navbar-brand {
                font-weight: 800;
                font-size: 1.5rem;
                color: #0f172a;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .public-nav .nav-link {
                font-weight: 500;
                color: #475569;
                margin: 0 1rem;
            }

                .public-nav .nav-link:hover {
                    color: var(--brand-color);
                }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="public-nav sticky-top">
        <div class="container d-flex align-items-center justify-content-between">
            <a href="/" class="navbar-brand"><i class="bi bi-mortarboard-fill text-primary"></i> Examprep</a>
            <div class="d-none d-md-flex align-items-center">
                <a href="#" class="nav-link">Features</a>
                <a href="#" class="nav-link">Pricing</a>
                <a href="#" class="nav-link">About</a>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (Context.Session.GetString("jwt") != null)
                {
                    <a href="/Home/Dashboard" class="btn btn-primary fw-medium px-4">Go to Dashboard</a>
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-link text-decoration-none text-dark fw-medium">Login</a>
                    <a href="/Account/Register" class="btn btn-primary fw-medium px-4">Get Started</a>
                }
            </div>
        </div>
    </nav>

    <main>@RenderBody()</main>

    <footer class="py-5 mt-5 bg-white border-top">
        <div class="container text-center text-muted">
            <p class="mb-0">&copy; @DateTime.Now.Year Examprep. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>