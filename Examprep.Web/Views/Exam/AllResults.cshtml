@model List<Examprep.Application.DTOs.AdminExamResultDto>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "All Exam Results";
}

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total Attempts</div>
                <div class="h3 mb-0 text-primary">@Model.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Passed</div>
                <div class="h3 mb-0 text-success">@Model.Count(r => r.ScorePercent >= 60)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Failed</div>
                <div class="h3 mb-0 text-danger">@Model.Count(r => r.ScorePercent < 60)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Avg Score</div>
                <div class="h3 mb-0 text-warning">
                    @(Model.Count > 0 ? (int)Model.Average(r => r.ScorePercent) : 0)%
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Count > 0)
{
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-pie-chart-fill text-primary me-1"></i> Pass vs Fail</h5>
                </div>
                <div class="card-body">
                    <canvas id="passFailChart" style="max-height:280px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-fill text-success me-1"></i> Score Distribution</h5>
                </div>
                <div class="card-body">
                    <canvas id="scoreChart" style="max-height:280px;"></canvas>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size:3rem;"></i>
            <p class="mt-2 mb-0">No exam attempts yet.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-table me-1"></i> User Performance</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th style="width:120px;">Score</th>
                            <th style="width:180px;">Percent</th>
                            <th style="width:130px;">Result</th>
                            <th style="width:180px;">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td><i class="bi bi-person-circle text-secondary me-1"></i>@r.UserEmail</td>
                                <td><strong>@r.CorrectCount</strong> / @r.TotalQuestions</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:6px;">
                                            <div class="progress-bar @(r.ScorePercent >= 60 ? "bg-success" : "bg-danger")"
                                                 style="width:@r.ScorePercent%"></div>
                                        </div>
                                        <small class="text-muted">@r.ScorePercent%</small>
                                    </div>
                                </td>
                                <td>
                                    @if (r.ScorePercent >= 60)
                                    {
                                        <span class="badge bg-success">Passed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Failed</span>
                                    }
                                </td>
                                <td class="text-muted small">@r.CompletedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    @if (Model.Count > 0)
    {
        var passed = Model.Count(r => r.ScorePercent >= 60);
        var failed = Model.Count - passed;

        var buckets = new[] { 0, 0, 0, 0, 0 };
        foreach (var r in Model)
        {
            if (r.ScorePercent <= 20) buckets[0]++;
            else if (r.ScorePercent <= 40) buckets[1]++;
            else if (r.ScorePercent <= 60) buckets[2]++;
            else if (r.ScorePercent <= 80) buckets[3]++;
            else buckets[4]++;
        }

        <script>
            new Chart(document.getElementById('passFailChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Passed', 'Failed'],
                    datasets: [{
                        data: [@passed, @failed],
                        backgroundColor: ['#198754', '#dc3545'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            new Chart(document.getElementById('scoreChart'), {
                type: 'bar',
                data: {
                    labels: ['0-20%', '21-40%', '41-60%', '61-80%', '81-100%'],
                    datasets: [{
                        label: 'Attempts',
                        data: [@buckets[0], @buckets[1], @buckets[2], @buckets[3], @buckets[4]],
                        backgroundColor: ['#dc3545', '#fd7e14', '#ffc107', '#0dcaf0', '#198754'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });
        </script>
    }
}