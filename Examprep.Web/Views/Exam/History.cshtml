@model List<Examprep.Application.DTOs.ExamHistoryDto>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #0f172a;">
            <i class="bi bi-clock-history text-primary me-2"></i> My Exam History
        </h2>
        <p class="text-muted mb-0">Review your past exam attempts and scores.</p>
    </div>
    <a asp-controller="Exam" asp-action="Start" class="btn btn-primary fw-medium">
        <i class="bi bi-plus-circle me-1"></i> Take New Exam
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <p class="mt-3 mb-0 text-muted">You haven't taken any exams yet.</p>
            <a asp-controller="Exam" asp-action="Start" class="btn btn-primary mt-3">
                <i class="bi bi-play-circle me-1"></i> Take Your First Exam
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 ps-4">Attempt</th>
                            <th class="border-0">Date</th>
                            <th class="border-0">Score</th>
                            <th class="border-0">Percent</th>
                            <th class="border-0 rounded-end pe-4">Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                                        #@exam.AttemptId
                                    </span>
                                </td>
                                <td class="text-muted">@exam.CompletedAt.AddHours(6).ToString("dd MMM yyyy hh:mm tt")</td>
                                <td class="fw-bold">@exam.CorrectCount / @exam.TotalQuestions</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; min-width: 80px;">
                                            <div class="progress-bar @(exam.ScorePercent >= 60 ? "bg-success" : "bg-danger")"
                                                 style="width:@exam.ScorePercent%"></div>
                                        </div>
                                        <small class="text-muted fw-bold">@exam.ScorePercent%</small>
                                    </div>
                                </td>
                                <td>
                                    @if (exam.ScorePercent >= 60)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Passed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i>Failed
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}